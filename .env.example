# Copie este arquivo para .env e preencha com seus valores reais.

# Obrigatório
DISCORD_TOKEN=seu_token_discord_aqui

# Opcional: sem a chave, o comando /sec fica desativado
OPENAI_API_KEY=sua_chave_openai_aqui
OPENAI_MODEL=gpt-5-mini

# Opcional: ID do servidor de desenvolvimento (habilita /dev reload e /dev sync para o dono do bot)
DEV_GUILD_ID=

# Opcional: fuso padrão dos agendamentos (cada servidor pode mudar com /config timezone)
DEFAULT_TIMEZONE=America/Sao_Paulo

# Opcional: sincronizar slash commands a cada inicialização (true/false)
SYNC_COMMANDS_ON_STARTUP=true

# Opcional: caminhos relativos à pasta do projeto
DB_PATH=arcbot.db
LOG_PATH=arcbot.log
LOG_LEVEL=INFO
